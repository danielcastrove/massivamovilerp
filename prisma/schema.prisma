generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  password_hash    String
  nombre           String?
  apellido         String?
  telefono_celular String?
  cargo            String?
  status           UserStatus @default(ACTIVE)
  role             UserRole   @default(CLIENTE)
  is_active        Boolean    @default(true)
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt
  roles_id         String?
  accounts         Account[]
  Customer         Customer?
  sessions         Session[]
  roles            Role?      @relation(fields: [roles_id], references: [id])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Customer {
  id                                  String         @id @default(uuid())
  user_id                             String?        @unique
  type                                CustomerType
  tipo_doc_identidad                  DocumentType?
  name                                String
  doc_number                          String         @unique
  telefono_empresa                    String?
  telefono_celular                    String?
  email                               String?
  direccion_fiscal                    String?
  settings                            Json?
  status                              CustomerStatus @default(ACTIVE)
  documents                           Json?
  bank_account_info                   Json?
  socios_info                         Json?
  persona_contacto_info               Json?
  representante_legal_info            Json?
  documento_constitutivo_info         Json?
  persona_cobranza_info               Json?
  fecha_constitucion                  DateTime?
  urbanizacion                        String?
  ciudad                              String?
  estado                              String?
  pais                                String?
  codigo_postal                       String?
  rubro                               Rubro?
  que_vendes                          String?
  tipo_venta                          SaleType?
  figura_legal                        LegalFigure?
  tipo_empresa                        CompanyType?
  descripcion_ventas                  String?
  sitio_web                           String?
  is_agente_retencion                 Boolean        @default(false)
  porcent_retencion_islr              Decimal?       @db.Decimal(5, 2)
  porcent_retencion_iva               Decimal?       @db.Decimal(5, 2)
  porcent_retencion_municipio         Decimal?       @db.Decimal(5, 2)
  fecha_registro                      DateTime?
  ip_registro                         String?
  fecha_eliminacion                   DateTime?
  ip_eliminacion                      String?
  is_acepta_terminos                  Boolean        @default(false)
  fecha_acepta_terminos               DateTime?
  ip_acepta_terminos                  String?
  is_acepta_boletin                   Boolean        @default(false)
  fecha_acepta_boletin                DateTime?
  ip_acepta_boletin                   String?
  is_acepta_declaracion_jurada        Boolean        @default(false)
  fecha_declaracion_jurada            DateTime?
  ip_declaracion_jurada               String?
  email_user_masiva_SMS               String?
  email_user_masiva_whatsapp          String?
  solo_enviar_cobro_contacto_oobranza Boolean        @default(false)
  servicios_contratados               Json?          // Array de arrays: [[priceListId, productId, isManual, customName], ...]
  reseteado_sms                       Boolean        @default(false)
  fecha_reseteado                     DateTime?
  cantidad_sms_antes_reset            Int?
  recurrencia_compra_SMS              RecurrenceType?
  recurrencia_compra_whatsapp         RecurrenceType?
  created_at                          DateTime       @default(now())
  updated_at                          DateTime       @updatedAt
  user                                User?          @relation(fields: [user_id], references: [id])
  invoices                            Invoice[]
  payments                            Payment[]
}

model Product {
  id             String         @id @default(uuid())
  sku            String         @unique
  name           String         @unique
  type           ProductType
  billing_cycle  BillingCycle? // Nullable for ONE_TIME products
  categoryId     String?        // Foreign key for Category
  category       Category?      @relation(fields: [categoryId], references: [id])
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  invoice_items  InvoiceItem[]
  product_prices ProductPrice[]
  leads          Lead[]     // Opposite relation for Lead
}

model PriceList {
  id             String         @id @default(uuid())
  name           String         @unique
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  product_prices ProductPrice[]
  invoice_items  InvoiceItem[]
  leads          Lead[]     // Opposite relation for Lead
}

model ProductPrice {
  id            String    @id @default(uuid())
  product_id    String
  price_list_id String
  price_usd     Decimal   @db.Decimal(10, 2)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  priceList     PriceList @relation(fields: [price_list_id], references: [id])
  product       Product   @relation(fields: [product_id], references: [id])

  @@unique([product_id, price_list_id])
}

model Invoice {
  id                           String        @id @default(uuid())
  customer_id                  String
  type                         InvoiceType
  status                       InvoiceStatus @default(DRAFT)
  issue_date                   DateTime      @default(now())
  due_date                     DateTime
  currency_rate                Decimal       @db.Decimal(10, 4)
  subtotal_usd                 Decimal       @db.Decimal(10, 2)
  tax_amount_usd               Decimal       @db.Decimal(10, 2)
  igtf_amount_usd              Decimal       @default(0) @db.Decimal(10, 2)
  total_usd                    Decimal       @db.Decimal(10, 2)
  subtotal_bs                  Decimal       @db.Decimal(10, 2)
  tax_amount_bs                Decimal       @db.Decimal(10, 2)
  total_bs                     Decimal       @db.Decimal(10, 2)
  retention_amount_bs          Decimal       @db.Decimal(10, 2)
  currency_mode                String        @default("USD_BS")
  invoice_number               Int?
  control_number               Int?
  proximo_vencimiento_producto DateTime?
  created_at                   DateTime      @default(now())
  updated_at                   DateTime      @updatedAt
  customer                     Customer      @relation(fields: [customer_id], references: [id])
  invoice_items                InvoiceItem[]
}

model Payment {
  id             String        @id @default(uuid())
  customer_id    String?
  amount_paid    Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD") // USD or BS
  exchange_rate  Decimal       @db.Decimal(10, 4)
  payment_method String        // Zelle, Transferencia, Pago Movil, etc.
  reference      String?
  evidence_url   String?
  payment_date   DateTime      @default(now())
  notes          String?       @db.Text
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  customer       Customer?     @relation(fields: [customer_id], references: [id], onDelete: Cascade)
}

model InvoiceItem {
  id             String   @id @default(uuid())
  invoice_id     String
  product_id     String?
  price_list_id  String?  // Foreign key to trace which price list was used
  is_custom      Boolean  @default(false)
  custom_name    String?
  quantity       Int
  unit_price_usd Decimal  @db.Decimal(10, 2)
  total_usd      Decimal  @db.Decimal(10, 2)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt
  invoice        Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  product        Product? @relation(fields: [product_id], references: [id])
  priceList      PriceList? @relation(fields: [price_list_id], references: [id])
}

model Lead {
  id             String      @id @default(uuid())
  nombre         String
  apellido       String
  cedula         String?
  email          String?
  telefono       String?
  
  // Producto interesado (Catálogo o Manual)
  productId      String?
  priceListId    String?
  custom_product String?     // Si no es un producto de catálogo
  
  procedencia    LeadSource
  fecha_contacto DateTime    @default(now())
  comentarios    String?     @db.Text
  fecha_llamada  DateTime?   // Fecha programada o realizada de llamada del vendedor
  status         LeadStatus  @default(SIN_CONTACTAR)
  tipo_lead      LeadType    @default(NORMAL)
  
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  product        Product?    @relation(fields: [productId], references: [id])
  priceList      PriceList?  @relation(fields: [priceListId], references: [id])
}

enum LeadSource {
  SITIO_WEB
  LLAMADA
  WHATSAPP
  RECOMENDACION
  INSTAGRAM
  OTRO
}

enum LeadStatus {
  SIN_CONTACTAR
  PROPUESTA_ENVIADA
  LLAMADA_REALIZADA
  CONTACTO_REALIZADO
  CLIENTE_CERRADO
  ESPERANDO_APROBACION
}

enum LeadType {
  NORMAL
  VIP
}

model Modulo {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  tipouser    Json?
  path        String?
  icon        String?
  roles       ModuloToRole[]
}

model Role {
  id         String         @id @default(uuid())
  name       String         @unique
  is_massiva Boolean        @default(false)
  created_at DateTime       @default(now())
  updated_at DateTime       @updatedAt
  modulos    ModuloToRole[]
  users      User[]
}

model Parametro {
  id         String   @id @default(uuid())
  key        String   @unique
  value      String
  updated_at DateTime @updatedAt
  created_at DateTime @default(now())
}

model TasaBcv {
  id             String    @id @default(uuid())
  tasa           Decimal   @db.Decimal(10, 4)
  fecha_efectiva DateTime  @unique @db.Date
  fecha_creacion DateTime  @default(now())
  fecha_inicio   DateTime  @db.Date
  fecha_fin      DateTime? @db.Date
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
}

model ModuloToRole {
  module_id   String
  role_id     String
  assigned_at DateTime @default(now())
  assigned_by String
  modulo      Modulo   @relation(fields: [module_id], references: [id])
  role        Role     @relation(fields: [role_id], references: [id])

  @@id([module_id, role_id])
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  products    Product[]
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
}

enum UserRole {
  MASSIVA_ADMIN
  MASSIVA_EXTRA
  CLIENTE
}

enum CustomerType {
  PERSONA
  EMPRESA
}

enum DocumentType {
  J
  V
  E
  P
  G
}

enum ProductType {
  RECURRENT
  ONE_TIME
}

enum BillingCycle {
  MONTHLY
  BIMONTHLY
}

enum InvoiceType {
  FACTURA
  RECIBO
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  RESET
  BLOCKED
  PAUSED
}

enum Rubro {
  COBRANZA
  SALUD_Y_FARMACIA
  INDUSTRIAS
  TELECOMUNICACIONES
  RETAIL
  TECNOLOGIA
  CONCESIONARIO
  FINANZAS
  SERVICIOS
  INSTITUCION
  SEGUROS
  EDUCACION
  LOTERIAS_OTP
  BAR_Y_RESTAURANTE
  SUPERMERCADO
  AGENCIA_MARKETING
  MOVILIDAD
  IGLESIA
  CAMPAMENTOS
  ENTRETENIMIENTO
  CLUBES
  OTRO
}

enum SaleType {
  MAYOR
  DETAL
  MAYOR_Y_DETAL
}

enum LegalFigure {
  PERSONA_JURIDICA
  GOBIERNO_EMPRENDEDOR_CON_FIRMA_PERSONAL
  EMPRENDEDOR_SOLO_CON_RIF
}

enum CompanyType {
  EMPRESA
  FABRICANTE
  PRODUCTOR
  DISTRIBUIDORA
  MAYORISTA
  COMERCIO
  RESTAURANT
  SUPERMERCADO
  ABASTO
  PANADERIA
  FARMACIA
}

enum RecurrenceType {
  MENSUAL
  BIMENSUAL
  TRES_MESES_A_UN_AÑO
  MAS_DE_UN_AÑO
}

enum UserStatus {
  ACTIVE
  INACTIVE
  RESET
  BLOCKED
  PAUSED
}
